#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3          &kp N4     &kp N5         &kp N6     &kp N7     &kp N8  &kp N9     &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E           &kp R      &kp T          &kp Y      &kp U      &kp I   &kp O      &kp P     &kp APOS
&kp CAPS   &kp A   &kp S   &kp D           &kp F      &kp G          &kp H      &kp J      &kp K   &kp L      &kp SEMI  &kp FSLH
&kp LSHFT  &kp Z   &kp X   &kp C           &kp V      &kp EQUAL      &kp B      &kp N      &kp M   &kp COMMA  &kp DOT   &kp RSHFT
                           &kp LANGUAGE_1  &kp LALT   &lt 1 ENTER    &kp LGUI   &mkp RCLK
                                           &kp LCTRL  &kp SPACE      &mkp LCLK
            >;
        };

        layer_1 {
            bindings = <
&kp ESC    &kp F1    &kp F2    &kp F3          &kp F4     &kp F5         &kp F6    &kp F7   &kp F8  &kp F9    &kp F10   &kp DEL
&kp TAB    &kp Q     &kp UP    &kp E           &kp R      &kp T          &kp Y     &kp U    &kp I   &kp F11   &kp F12   &kp APOS
&kp CAPS   &kp LEFT  &kp DOWN  &kp RIGHT       &kp F      &kp G          &kp H     &kp J    &kp K   &kp L     &kp BSLH  &kp PLUS
&kp LSHFT  &kp Z     &kp X     &kp C           &kp V      &kp MINUS      &kp B     &kp N    &kp M   &kp LBKT  &kp RBKT  &kp PAGE_DOWN
                               &kp LANGUAGE_2  &kp LALT   &lt 0 ENTER    &kp LGUI  &kp END
                                               &kp LCTRL  &kp SPACE      &kp HOME
            >;
        };
    };
};
